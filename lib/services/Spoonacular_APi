import 'dart:convert';
import 'dart:io';
import 'package:http/http.dart' as http;
import 'package:recipeasy/models/meal_planning.dart';
import 'package:recipeasy/models/recipe.dart';
import 'package:recipeasy/models/meal_model.dart';

class SpoonacularService {
  final String _apiKey = '8be11e6b2fdf466bbe400a81c87cfa65'; //4ec0a5012ea2487d87d999e1cacd916b 867c8584a6b2463ca4f842516e4c334d 64fffd0b3d124015bf4be97aefd2936b
  final String _baseUrl = 'https://api.spoonacular.com';

    Future<List<dynamic>> searchRecipes(String query, {int page = 1}) async {
      final url = Uri.parse(
          '$_baseUrl/recipes/complexSearch?query=$query&apiKey=$_apiKey&offset=${(page - 1) * 10}&number=10');
      final response = await http.get(url);

      if (response.statusCode == 200) {
        final data = json.decode(response.body);
        return data['results'];
      } else {
        throw Exception('Failed to fetch recipes: ${response.statusCode}');
      }
    }

    Future<Map<String, dynamic>> getRecipeDetails(int recipeId) async {
      final url = Uri.parse('$_baseUrl/recipes/$recipeId/information?apiKey=$_apiKey');
      final response = await http.get(url);

      if (response.statusCode == 200) {
        return json.decode(response.body);
      } else {
        throw Exception('Failed to fetch recipe details: ${response.statusCode}');
      }
    }

    Future<List<dynamic>> searchRecipesByIngredients(String ingredients) async {
      final url = Uri.parse(
          '$_baseUrl/recipes/findByIngredients?ingredients=$ingredients&apiKey=$_apiKey&number=10');
      final response = await http.get(url);

      if (response.statusCode == 200) {
        final data = json.decode(response.body);
        return data;
      } else {
        throw Exception('Failed to fetch recipes by ingredients: ${response.statusCode}');
      }
    }

    Future<List<dynamic>> getRandomRecipes() async {
      final url = Uri.parse('$_baseUrl/recipes/random?number=10&apiKey=$_apiKey');
      final response = await http.get(url);

      if (response.statusCode == 200) {
        final data = json.decode(response.body);
        return data['recipes'];
      } else {
        throw Exception('Failed to fetch random recipes: ${response.statusCode}');
      }
    }

    Future<MealPlan> generateMealPlan({
      required int targetCalories,
      String diet = '',
      int minProtein = 0,
      int minCarbs = 0,
      int minFat = 0,
      String includeIngredients = '',
      String excludeIngredients = '',
      String timeFrame = 'day',
    }) async {
      Map<String, String> parameters = {
        'timeFrame': timeFrame,
        'targetCalories': targetCalories.toString(),
        'apiKey': _apiKey,
      };

      if (diet.isNotEmpty) parameters['diet'] = diet;
      if (minProtein > 0) parameters['minProtein'] = minProtein.toString();
      if (minCarbs > 0) parameters['minCarbs'] = minCarbs.toString();
      if (minFat > 0) parameters['minFat'] = minFat.toString();
      if (includeIngredients.isNotEmpty) parameters['includeIngredients'] = includeIngredients;
      if (excludeIngredients.isNotEmpty) parameters['excludeIngredients'] = excludeIngredients;

      Uri uri = Uri.parse('$_baseUrl/recipes/mealplans/generate').replace(queryParameters: parameters);

      Map<String, String> headers = {
        HttpHeaders.contentTypeHeader: 'application/json',
      };

      try {
        var response = await http.get(uri, headers: headers);

        if (response.statusCode == 200) {
          Map<String, dynamic> data = json.decode(response.body);
          return MealPlan.fromMap(data);
        } else {
          throw Exception('Failed to generate meal plan: ${response.statusCode}');
        }
      } catch (err) {
        throw Exception('Error generating meal plan: $err');
      }
    }
  }